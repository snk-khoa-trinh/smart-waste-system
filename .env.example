# Local-only development. Never expose these unauthenticated services publicly.
DATABASE_URL=sqlite:///./demo.db
INFERENCE_PROVIDER=mock
ROBOFLOW_API_KEY=
ROBOFLOW_WORKSPACE=trinh-dang-khoa-shineekuwu
ROBOFLOW_WORKFLOW=waste-classifier-psdrg-0mtyc
ROBOFLOW_URL=https://serverless.roboflow.com
ROBOFLOW_OUTPUT=predictions
INFERENCE_TIMEOUT=15
CONFIDENCE_THRESHOLD=0.65
LABEL_MAPPING={"plastic":"recyclable","paper":"recyclable","metal":"recyclable","trash":"non_recyclable","battery":"e_waste"}
MAX_UPLOAD_BYTES=2000000
STORE_IMAGES=false
HEARTBEAT_EXPIRY=90
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USER=worker
MQTT_PASSWORD=worker-local
MQTT_SIM_PASSWORD=simulator-local
SIMULATOR_SEED=42
