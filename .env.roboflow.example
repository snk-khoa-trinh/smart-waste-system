# Copy to .env.roboflow for compose.roboflow.yaml; keep your existing private file.
# Opt-in live workflow. Requests may consume Roboflow credits.
# The API key remains only in the existing backend .env file.
ROBOFLOW_TEST_TIMEOUT=45
ROBOFLOW_TEST_OUTPUT=predictions
# Exact project labels verified through Roboflow metadata. Preserve raw labels.
ROBOFLOW_TEST_LABEL_MAPPING={"Recyclable":"recyclable","Non-Recyclable":"non_recyclable","E-Waste":"e_waste","Empty":"unknown"}
