# Trusted-LAN hardware overlay. Generate real device credentials with:
# uv run --directory backend python ../scripts/configure-hardware.py --ssid YOUR_2_4_GHZ_SSID
# Copying this file alone does not provision firmware credentials.
HARDWARE_BIND_IP=192.168.1.100
MQTT_CAMERA_PASSWORD=replace-with-generated-camera-password
MQTT_MONITOR_PASSWORD=replace-with-generated-monitor-password
